{
  "name": "cauldron",
  "private": true,
  "version": "7.4.0",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf dist docs/dist",
    "build": "concurrently \"pnpm build:styles\" \"pnpm build:react\" && pnpm build:docs && pnpm build:storybook",
    "build:react": "cross-env NODE_ENV=production pnpm --filter @deque/cauldron-react build",
    "build:styles": "cross-env NODE_ENV=production pnpm --filter @deque/cauldron-styles build",
    "build:docs": "cross-env NODE_ENV=production webpack --bail",
    "build:storybook": "storybook build -o docs/dist/storybook",
    "dev": "concurrently \"pnpm dev:styles\" \"pnpm dev:react\" \"pnpm dev:docs\"",
    "dev:react": "pnpm --filter @deque/cauldron-react dev",
    "dev:styles": "pnpm --filter @deque/cauldron-styles dev",
    "dev:docs": "webpack-dev-server",
    "dev:storybook": "storybook dev -p 6006",
    "fmt": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --quiet",
    "typecheck": "pnpm --filter @deque/cauldron-react typecheck",
    "prebuild": "pnpm clean",
    "predev": "pnpm clean",
    "test": "pnpm --filter @deque/cauldron-react test",
    "test:a11y": "ts-node e2e/accessibility.ts",
    "screenshots": "docker run --rm --ipc=host -v $(pwd)/playwright-ct.config.ts:/app/playwright-ct.config.ts -v $(pwd)/packages:/app/packages -v $(pwd)/e2e:/app/e2e cauldron-playwright-e2e-screenshots",
    "screenshots:docker": "docker build . -t cauldron-playwright-e2e-screenshots -f e2e/Dockerfile --build-arg playwright_version=$(node -p \"require('playwright/package.json').version\") --build-arg pnpm_version=$(node -p \"require('./package.json').packageManager.split('@')[1]\")",
    "release": "./scripts/release.sh",
    "precommit": "lint-staged",
    "prepare": "husky"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.11.2",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/pt-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@mdx-js/loader": "^3.1.1",
    "@playwright/experimental-ct-react": "^1.61.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-themes": "^10.4.0",
    "@storybook/react": "^10.4.0",
    "@storybook/react-webpack5": "^10.4.0",
    "@svgr/webpack": "^8.1.0",
    "@types/classnames": "^2.3.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.3.2",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^5.59.9",
    "@typescript-eslint/parser": "^5.59.9",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-export-extensions": "^6.22.0",
    "chalk": "^4.1.2",
    "classnames": "^2.5.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-ssr-friendly": "^1.3.0",
    "express": "^5.2.1",
    "focusable": "^2.3.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "log-symbols": "4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-mdx-expression": "^2.0.1",
    "micromark-extension-mdxjs": "^3.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "minimatch": "^10.2.5",
    "node-fetch": "^3.3.0",
    "p-queue": "^9",
    "playwright": "^1.61.1",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3",
    "puppeteer": "^24.38.0",
    "react": "^19",
    "react-dom": "^19",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.15.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "remark-mdx-toc": "^0.3.1",
    "rimraf": "^6.1.3",
    "slugify": "^1.6.5",
    "standard-version": "^9.1.1",
    "storybook": "^10.4.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "unist-util-visit": "^5.0.0",
    "webpack": "^5.106.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^6.0.0"
  },
  "packageManager": "pnpm@11.4.0"
}
