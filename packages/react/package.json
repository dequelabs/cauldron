{
  "name": "@deque/cauldron-react",
  "version": "7.6.0",
  "license": "MPL-2.0",
  "description": "Fully accessible react components library for Deque Cauldron",
  "homepage": "https://cauldron.dequelabs.com/",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "module": "lib/esm/index.js",
  "style": "lib/cauldron.css",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "module": "./lib/esm/index.js",
      "default": "./lib/index.js"
    },
    "./lib/cauldron.css": "./lib/cauldron.css",
    "./lib/types": {
      "types": "./lib/types.d.ts"
    },
    "./lib/components/Accordion/*": {
      "types": "./lib/components/Accordion/*.d.ts"
    },
    "./lib/components/ActionList/*": {
      "types": "./lib/components/ActionList/*.d.ts"
    },
    "./lib/components/ActionMenu/*": {
      "types": "./lib/components/ActionMenu/*.d.ts"
    },
    "./lib/components/Breadcrumb/*": {
      "types": "./lib/components/Breadcrumb/*.d.ts"
    },
    "./lib/components/Combobox/*": {
      "types": "./lib/components/Combobox/*.d.ts"
    },
    "./lib/components/Dialog/*": {
      "types": "./lib/components/Dialog/*.d.ts"
    },
    "./lib/components/ExpandCollapsePanel/*": {
      "types": "./lib/components/ExpandCollapsePanel/*.d.ts"
    },
    "./lib/components/Icon/*": {
      "types": "./lib/components/Icon/*.d.ts"
    },
    "./lib/components/Listbox/*": {
      "types": "./lib/components/Listbox/*.d.ts"
    },
    "./lib/components/LoaderOverlay/*": {
      "types": "./lib/components/LoaderOverlay/*.d.ts"
    },
    "./lib/components/MenuItem/*": {
      "types": "./lib/components/MenuItem/*.d.ts"
    },
    "./lib/components/NavBar/*": {
      "types": "./lib/components/NavBar/*.d.ts"
    },
    "./lib/components/OptionsMenu/*": {
      "types": "./lib/components/OptionsMenu/*.d.ts"
    },
    "./lib/components/Pagination/*": {
      "types": "./lib/components/Pagination/*.d.ts"
    },
    "./lib/components/Panel/*": {
      "types": "./lib/components/Panel/*.d.ts"
    },
    "./lib/components/SideBar/*": {
      "types": "./lib/components/SideBar/*.d.ts"
    },
    "./lib/components/Table/*": {
      "types": "./lib/components/Table/*.d.ts"
    },
    "./lib/components/Tabs/*": {
      "types": "./lib/components/Tabs/*.d.ts"
    },
    "./lib/components/Timeline/*": {
      "types": "./lib/components/Timeline/*.d.ts"
    },
    "./lib/components/Toast/*": {
      "types": "./lib/components/Toast/*.d.ts"
    },
    "./lib/components/TopBar/*": {
      "types": "./lib/components/TopBar/*.d.ts"
    },
    "./lib/components/TreeView/*": {
      "types": "./lib/components/TreeView/*.d.ts"
    },
    "./lib/components/TwoColumnPanel/*": {
      "types": "./lib/components/TwoColumnPanel/*.d.ts"
    },
    "./lib/components/*": {
      "types": "./lib/components/*/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib/"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm build:css",
    "prebuild:lib": "node scripts/buildIconTypes.js",
    "build:lib": "rimraf lib && rollup -c",
    "build:css": "postcss --output=lib/cauldron.css src/index.css",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "verify:packaging": "pnpm build && node scripts/verifyPackaging.js",
    "dev": "concurrently 'pnpm build:css --watch' 'rollup -c --watch'",
    "prepublishOnly": "NODE_ENV=production pnpm build",
    "test": "jest --maxWorkers=1 --coverage",
    "figma:parse": "figma connect parse",
    "figma:publish": "figma connect publish",
    "figma:publish:dry-run": "figma connect publish --dry-run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react-dom": "^2.1.2",
    "classnames": "^2.2.6",
    "focusable": "^2.3.0",
    "keyname": "^0.1.0",
    "react-aria-components": "^1.20.0",
    "react-id-generator": "^3.0.1",
    "react-syntax-highlighter": "^16.1.1",
    "tslib": "^2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@figma/code-connect": "^1.4.5",
    "@rollup/plugin-commonjs": "^14.0.0",
    "@rollup/plugin-dynamic-import-vars": "^1.4.2",
    "@rollup/plugin-typescript": "^11.1.2",
    "@svgr/rollup": "^6.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/classnames": "^2.2.10",
    "@types/jest": "^29.5.11",
    "@types/jest-axe": "^3.5.4",
    "@types/node": "^17.0.42",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sinon": "^10",
    "autoprefixer": "^10.5.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-export-extensions": "^6.22.0",
    "concurrently": "^5.3.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "nyc": "^15.0.1",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.1",
    "prop-types": "^15.8.1",
    "publint": "^0.3.21",
    "react": "^19",
    "react-dom": "^19",
    "rimraf": "^6.1.3",
    "rollup": "^2.23.0",
    "sinon": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dequelabs/cauldron.git"
  },
  "peerDependencies": {
    "react": ">=16.6 <20",
    "react-dom": ">=16.6 <20",
    "@types/react-syntax-highlighter": "^15.5.13"
  },
  "peerDependenciesMeta": {
    "@types/react-syntax-highlighter": {
      "optional": true
    }
  }
}
